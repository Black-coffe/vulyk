# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# VULYK runtime artifacts that should stay local
memory/snapshots/*
!memory/snapshots/.gitkeep
memory/map/.stale

# Session handoffs are per-machine session state, never committed
.claude/handoff/

# Update-check polling state (when we last asked GitHub, and what it said)
.claude/.vulyk-update-cache
# Installer backup taken before wiring a hook into your settings
.claude/settings.json.vulyk-bak

# Local-only Claude Code settings (commit settings.json, not local overrides)
.claude/settings.local.json
CLAUDE.local.md

# Python bytecode (handoff.py)
__pycache__/
