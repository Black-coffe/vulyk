# Shell and Python must check out with LF everywhere: install.sh runs on Linux/macOS/Git Bash,
# and a CRLF shebang line breaks all three in different ways.
* text=auto
*.sh text eol=lf
*.py text eol=lf
scripts/git-hooks/* text eol=lf
# Workflow driver scripts: the Workflow tool refuses a script with CR bytes ("control characters").
.claude/workflows/*.js text eol=lf
