# Shell and Python must check out with LF everywhere: install.sh runs on Linux/macOS/Git Bash,
# and a CRLF shebang line breaks all three in different ways.
* text=auto
*.sh text eol=lf
*.py text eol=lf
scripts/git-hooks/* text eol=lf
# JavaScript and JSON: the Workflow tool refuses a driver script with CR bytes ("control
# characters"), and settings.json / the hook fixtures are read byte for byte by the tests.
*.js text eol=lf
*.json text eol=lf
